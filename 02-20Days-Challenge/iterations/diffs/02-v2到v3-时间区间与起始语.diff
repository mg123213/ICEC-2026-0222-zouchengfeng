+def _link_ranges(text: str, candidates: List[TimeCandidate]) -> None:
+    """把 「A 至 B」 标记为区间，避免把开始时间当成截止时间。
+
+    v0.1.0 在「选课时间为11月18日9:00至11月22日24:00」上取到了 11-18 09:00，
+    这是最容易被用户直接照做、从而错过截止的一类错误，必须专门处理。
+    """
