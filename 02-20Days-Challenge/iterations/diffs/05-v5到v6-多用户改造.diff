-
-# 时刻候选：支持 17:30 / 17点30分 / 17时30分 / 5点半 / 下午5点
-_TIME_RE = re.compile(
-    r"(?P<ampm>上午|下午|晚上|傍晚|中午|凌晨|早上|晚间)?\s*"
-    r"(?P<h>\d{1,2})\s*"
-    r"(?:"
-    r":\s*(?P<mi1>\d{1,2})"
-    r"|点\s*(?:(?P<mi2>\d{1,2})\s*分?|(?P<half>半))?"
-    r"|时\s*(?:(?P<mi3>\d{1,2})\s*分?)?"
