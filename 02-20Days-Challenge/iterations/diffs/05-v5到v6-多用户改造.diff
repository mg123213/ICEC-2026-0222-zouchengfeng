-
-_WEEKDAY_INDEX = {"一": 0, "二": 1, "三": 2, "四": 3, "五": 4, "六": 5, "日": 6, "天": 6}
-
-# 只在后面紧跟时间单位时才做中文数字转换，避免误伤普通词语
-_CN_DIGITIZE = re.compile(
-    rf"([{_CN_NUM_CHARS}]{{1,3}})(?=\s*(?:年|月|日|号|时|点|分|天|周|星期|礼拜|份|张|本|套|件|支|台|把))"
