+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>登录 · 校园通知雷达</title>
+<link rel="stylesheet" href="/static/style.css">
+</head>
+<body>
+
+<div class="auth-wrap">
+  <div class="auth-card">
+    <div class="auth-brand">
+      <div class="auth-mark">雷</div>
+      <h1>校园通知雷达</h1>
+    </div>
+    <p class="auth-sub">把群消息和通知贴进来，自动挑出截止时间、地点和材料</p>
+
+    <div class="auth-tabs">
+      <button id="tab-login" class="active" type="button">登录</button>
+      <button id="tab-register" type="button">注册</button>
+    </div>
+
+    <form id="auth-form" autocomplete="off">
+      <label class="field-label" for="student-id">学号</label>
+      <input id="student-id" type="text" inputmode="numeric" placeholder="例如 2024400222" maxlength="12" required>
+
+      <label class="field-label" for="password">密码</label>
+      <input id="password" type="password" placeholder="至少 6 位，需含字母和数字" maxlength="64" required>
+
+      <div id="confirm-wrap" hidden>
+        <label class="field-label" for="password2">确认密码</label>
+        <input id="password2" type="password" placeholder="再输一次" maxlength="64">
+      </div>
+
+      <button class="btn primary block" id="btn-submit" type="submit" style="margin-top:18px">登录</button>
+      <p class="auth-msg" id="auth-msg"></p>
+    </form>
+
+    <div class="auth-foot">
+      首次使用请先点「注册」创建账号。<br>
+      每个账号只能看到自己的待办，互不可见。
+    </div>
+  </div>
+</div>
+
+<script src="/static/login.js"></script>
+</body>
+</html>
diff -ruN iterations/v5_线上部署适配/src/web/login.js iterations/v6_多用户改造/src/web/login.js
--- iterations/v5_线上部署适配/src/web/login.js	1970-01-01 08:00:00.000000000 +0800
+++ iterations/v6_多用户改造/src/web/login.js	2026-11-17 14:10:51.292993000 +0800
@@ -0,0 +1,103 @@
+/* 登录 / 注册页 */
+
+const $ = (sel, root = document) => root.querySelector(sel);
+const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
+
+/* 线上发布后网关要求每个请求带 sharecode */
+const SHARE_CODE =
+  window.__SHARE_CODE__ || new URLSearchParams(location.search).get("sharecode") || "";
+
+function withShare(path) {
+  if (!SHARE_CODE) return path;
+  return path + (path.includes("?") ? "&" : "?") + "sharecode=" + encodeURIComponent(SHARE_CODE);
+}
+
+let mode = "login";
+
+const MESSAGES = {
+  invalid_student_id: "学号应为 8–12 位数字",
+  weak_password: "密码至少 6 位，且需同时包含字母和数字",
+  student_exists: "该学号已注册，请直接登录",
+  invalid_credentials: "学号或密码不正确",
+  too_many_attempts: "失败次数过多，请 5 分钟后再试",
+  empty_input: "请填写学号和密码",
+};
+
+function setMode(next) {
+  mode = next;
+  $("#tab-login").classList.toggle("active", next === "login");
+  $("#tab-register").classList.toggle("active", next === "register");
+  $("#confirm-wrap").hidden = next !== "register";
+  $("#btn-submit").textContent = next === "login" ? "登录" : "注册并登录";
+  $("#auth-msg").textContent = "";
+  $("#auth-msg").className = "auth-msg";
+}
+
+$("#tab-login").addEventListener("click", () => setMode("login"));
+$("#tab-register").addEventListener("click", () => setMode("register"));
+
+function showMessage(text, ok = false) {
+  const el = $("#auth-msg");
+  el.textContent = text;
+  el.className = "auth-msg" + (ok ? " ok" : "");
+}
+
+$("#auth-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+
+  const studentId = $("#student-id").value.trim();
+  const password = $("#password").value;
+  const password2 = $("#password2").value;
+
+  if (!studentId || !password) {
+    showMessage(MESSAGES.empty_input);
+    return;
+  }
+  if (mode === "register" && password !== password2) {
+    showMessage("两次输入的密码不一致");
+    return;
+  }
+
+  const btn = $("#btn-submit");
+  btn.disabled = true;
+  const original = btn.textContent;
+  btn.textContent = mode === "login" ? "登录中…" : "注册中…";
+
+  try {
+    if (mode === "register") {
+      const res = await fetch(withShare("/api/register"), {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ student_id: studentId, password }),
+      });
+      const data = await res.json();
+      if (!data.ok) {
+        showMessage(MESSAGES[data.error] || "注册失败，请重试");
+        return;
+      }
+      showMessage("注册成功，正在登录…", true);
+    }
+
+    const res = await fetch(withShare("/api/login"), {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ student_id: studentId, password }),
+    });
+    const data = await res.json();
+
+    if (data.ok) {
+      showMessage("登录成功，正在进入…", true);
+      // reload 而不是跳转：保持地址栏里的 sharecode 不丢
+      setTimeout(() => location.reload(), 260);
+    } else {
+      showMessage(MESSAGES[data.error] || "登录失败，请重试");
+    }
+  } catch (err) {
+    showMessage("网络错误：" + err.message);
+  } finally {
+    btn.disabled = false;
+    btn.textContent = original;
+  }
+});
+
+setMode("login");
