+         </div>
+         <div class="deadline-raw">原文：${esc(dl.raw)} · 置信度 ${Math.round(dl.confidence * 100)}%${
+           dl.assumed_midnight ? " · 原文未写时刻，按 23:59 计" : ""
+         }</div>
+       </div>`
