+# 提交语境：整篇没有这类动作时，说明它不是在叫人去哪儿交东西，
+# 此时不应输出「提交地点」（例如「图书馆延长开放时间」里的图书馆）
+_SUBMIT_ACTION = re.compile(
+    r"交至|提交|上交|报送|送至|递交|前往|集合|领取|办理|"
+    r"[到在]\s*[\u4e00-\u9fa5A-Za-z0-9]{0,8}(?:楼|室|馆|厅)"
+)
+
+# 太泛的地点名，有更好的候选时应跳过
+_GENERIC_LOCATIONS = {"办公室", "教室", "会议室", "实训室", "机房", "报告厅", "中心", "门口"}
+
+_CONTACT_RE = re.compile(
+    r"(?:联系人|联系老师|咨询电话|联系电话|联系)\s*[:：]?\s*"
+    r"([\u4e00-\u9fa5]{2,4}?)(?:老师|同学|主任|科长|辅导员)?(?=[，,。；;\s（(]|$)"
+)
+_PHONE_RE = re.compile(r"(?<!\d)(1[3-9]\d{9}|\d{3,4}[-\s]\d{4}[\s-]?\d{4})(?!\d)")
+
+# 这些不是人名，是部门
+_CONTACT_BLACKLIST = {
+    "教务科", "学生处", "团委", "办公室", "实训室", "财务处", "图书馆",
+    "宿管", "后勤", "保卫处", "招生办", "教务处", "学工部", "校团委",
+}
+
+# 待办动作：祈使句里常见的动词
+_ACTION_VERBS = (
+    "报名", "提交", "上交", "交至", "交到", "报送", "送至", "填写", "填报", "参加",
+    "领取", "确认", "缴纳", "缴费", "打印", "签字", "登录", "扫码", "加入",
+    "携带", "准备", "核对", "归还", "签到",
+)
+# 前置 (?<![\u4e00-\u9fa5]) 很关键：否则「申请」里的「请」会被当成祈使句开头，
+# 抽出一句「请表》一式两份，需班主任签字」这种脏结果
+_ACTION_RE = re.compile(
+    r"(?<![\u4e00-\u9fa5])(?:请|需|须|务必|应|及时)"
+    r"[^。；\n]{0,40}?(?:" + "|".join(_ACTION_VERBS) + r")[^。；\n]{0,20}"
+)
+
+_SENT_SPLIT = re.compile(r"[。！？；\n]+")
+_CLAUSE_SPLIT = re.compile(r"[，,]")
+_ITEM_SPLIT = re.compile(r"(?:^|\s)(?:\d{1,2}[.、)）]|[①-⑩]|[（(]\d{1,2}[)）]|[·•\-–—])\s*|、|和|及|以及")
+_BRACKET = re.compile(r"[（(][^）)]*[）)]")
+
+_CN_NUM = {"一": 1, "二": 2, "两": 2, "三": 3, "四": 4, "五": 5, "六": 6,
+           "七": 7, "八": 8, "九": 9, "十": 10}
+
+
+# --------------------------------------------------------------------- 工具
+def split_sentences(text: str) -> List[str]:
+    """按中文标点切句，保留非空片段。"""
+    return [s.strip() for s in _SENT_SPLIT.split(text) if s and s.strip()]
+
+
+def _normalize_space(text: str) -> str:
+    return re.sub(r"[ \t\u3000]+", " ", text.replace("\r\n", "\n").replace("\r", "\n")).strip()
+
+
+def guess_title(text: str) -> str:
+    """优先取「关于……的通知」句式，否则取首行并截到第一个句末标点。"""
+    match = re.search(r"(关于[^。\n]{4,50}?(?:通知|公告|公示|安排|须知))", text)
+    if match:
+        return match.group(1).strip()
+
+    head = _normalize_space(text).split("\n")[0][:80]
+    head = re.sub(r"^@\S+\s*", "", head)                       # 去掉 @全体成员
+    head = re.sub(r"^[【\[][^】\]]{1,20}[】\]]\s*", "", head)   # 去掉【通知】类前缀
+    head = re.split(r"[。！？；]", head)[0].strip()
+    head = re.sub(r"^(?:通知|通知：|公告|提醒)\s*[:：]?\s*", "", head)
+    return head[:50] or "未命名通知"
+
+
+# --------------------------------------------------------------------- 材料
+def _clean_material_name(item: str) -> str:
+    """去掉数量、书名号、多余虚词，留下材料本体。"""
+    name = _QTY_CN.sub("", item)
+    name = _QTY_RE.sub("", name)
+    name = name.replace("一式", "").replace("《", "").replace("》", "")
+    name = re.sub(r"^(?:携带|带上|带好|自带|提交|上交|提供|准备|备齐|并)", "", name)
+    name = name.strip(" 　，,。.：:；;、的及各")
+    return name
+
+
+def _extract_materials(text: str) -> Tuple[List[Dict[str, object]], List[str]]:
+    """抽取材料清单，返回 (材料列表, 命中的证据句)。"""
+    materials: List[Dict[str, object]] = []
+    evidence: List[str] = []
+    seen = set()
+
+    for sentence in split_sentences(text):
+        # 句子里既没有提交类动词，也没有具体材料名，直接跳过
+        if not _MATERIAL_HINTS.search(sentence) and not _MATERIAL_ITEM_HINTS.search(sentence):
+            continue
+        if "截止" not in sentence and _MATERIAL_ITEM_HINTS.search(sentence):
+            pass
+
+        stripped = _BRACKET.sub("", sentence)      # 去掉补充说明的括号内容
+        hit_this_sentence = False
+
+        for clause in _CLAUSE_SPLIT.split(stripped):
+            clause = clause.strip(" 　")
+            if not clause or not re.search(r"[\u4e00-\u9fa5]", clause):
+                continue
+
+            # 剥掉「请……携带」这类动词前缀
+            body = _VERB_PREFIX.sub("", clause).strip(" 　")
+            if not body:
+                continue
+
+            for chunk in _ITEM_SPLIT.split(body):
+                if not chunk:
+                    continue
+                item = chunk.strip(" 　，,。.：:；;、")
+                if not (2 <= len(item) <= 22):
+                    continue
+                if not _MATERIAL_ITEM_HINTS.search(item):
+                    continue
+                if _MATERIAL_BLACKLIST.search(item):
+                    continue
+
+                qty, unit = None, None
+                cn_qty = _QTY_CN.search(item)
+                if cn_qty:
+                    qty, unit = _CN_NUM.get(cn_qty.group(1)), "份"
+                else:
+                    qty_match = _QTY_RE.search(item)
+                    if qty_match:
+                        raw_qty = qty_match.group(1)
+                        qty = int(raw_qty) if raw_qty.isdigit() else _CN_NUM.get(raw_qty)
+                        unit = qty_match.group(2)
+
+                name = _clean_material_name(item)
+                if len(name) < 2 or name in seen or name.isdigit():
+                    continue
+                seen.add(name)
+                materials.append({"name": name[:24], "qty": qty, "unit": unit})
+                hit_this_sentence = True
+                if len(materials) >= 12:
+                    break
+
+            if hit_this_sentence and sentence[:80] not in evidence:
+                evidence.append(sentence[:80])
+            if len(materials) >= 12:
+                break
+
+        if len(materials) >= 12:
+            break
+
+    return materials, evidence[:4]
+
+
+# --------------------------------------------------------------------- 地点
+def _location_candidates(text: str) -> List[Tuple[str, int, int]]:
+    """定位所有地点后缀，向前后扩展成完整地点名。
+
+    这样得到的是「行政楼302室」而不是「00前将以下材料交至行政楼」——
+    关键在向前回溯时遇到「至/在/到/前/将」这类虚词就立即停止。
+    """
+    found: List[Tuple[str, int, int]] = []
+    for match in _LOC_SUFFIX_RE.finditer(text):
+        # 向前收集中文/字母，最多 6 字
+        left_chars: List[str] = []
+        cursor = match.start()
+        while cursor > 0 and len(left_chars) < 6:
+            ch = text[cursor - 1]
+            if ch in _LOC_STOP or not re.match(r"[\u4e00-\u9fa5A-Za-z]", ch):
+                break
+            left_chars.append(ch)
+            cursor -= 1
+        head = "".join(reversed(left_chars))
+
+        # 向后接房间号，如 302室 / B305 / 508
+        tail = ""
+        room = re.match(r"[A-Za-z]?\d{1,4}(?:室|号|房|教室)?", text[match.end():])
+        if room:
+            tail = room.group(0)
+
+        name = (head + match.group(0) + tail).strip()
+        if len(name) >= 3:
+            found.append((name, cursor, match.end() + len(tail)))
+    return found
+
+
+def _extract_location(text: str) -> Optional[str]:
+    """抽取提交/集合地点。优先取带「交至/在……集合」提示语的那一句。"""
+    if not _SUBMIT_ACTION.search(text):
+        return None
+
+    hinted: List[str] = []
+    plain: List[str] = []
+
+    for sentence in split_sentences(text):
+        candidates = [name for name, _, _ in _location_candidates(sentence)]
+        if not candidates:
+            continue
+        target = hinted if _LOCATION_HINT.search(sentence) else plain
+        for name in candidates:
+            if name not in target:
+                target.append(name)
+
+    for pool in (hinted, plain):
+        for name in pool:
+            if name in _GENERIC_LOCATIONS:
+                continue
+            return name[:24]
+
+    # 全是泛称时退回第一个
+    for pool in (hinted, plain):
+        if pool:
+            return pool[0][:24]
+    return None
+
+
+# --------------------------------------------------------------------- 其他
+def _extract_contacts(text: str) -> List[Dict[str, str]]:
+    contacts: List[Dict[str, str]] = []
+    for phone in _PHONE_RE.findall(text):
+        contacts.append({"name": "", "phone": phone})
+    for match in _CONTACT_RE.finditer(text):
+        name = match.group(1)
+        if name in _CONTACT_BLACKLIST or name in ("时间", "地点", "材料", "要求", "事项", "方式"):
+            continue
+        if any(c["name"] == name for c in contacts):
+            continue
+        contacts.append({"name": name, "phone": ""})
+    return contacts[:3]
+
+
+def _extract_actions(text: str) -> List[str]:
+    actions: List[str] = []
+    seen = set()
+    for match in _ACTION_RE.finditer(text):
+        item = match.group(0).strip(" 　，,。")
+        if len(item) < 6 or item in seen:
+            continue
+        seen.add(item)
+        actions.append(item[:48])
+    return actions[:6]
+
+
+def _extract_tags(text: str) -> List[str]:
+    tags = [tag for tag, words in _TAG_RULES.items() if any(w in text for w in words)]
+    return tags[:3]
+
+
+# --------------------------------------------------------------------- 主函数
+def parse_notice(text: str, now=None) -> Dict[str, object]:
+    """把一段通知文本解析成结构化结果。"""
+    now = now or timeparse.datetime.now()
+    raw = _normalize_space(text or "")
+    if not raw:
+        return {
+            "ok": False,
+            "error": "empty_input",
+            "warnings": ["没有拿到通知正文，请先粘贴内容"],
+        }
+
+    title = guess_title(raw)
+    deadline = timeparse.extract_deadline(raw, now=now)
+    materials, material_evidence = _extract_materials(raw)
+    location = _extract_location(raw)
+    contacts = _extract_contacts(raw)
+    actions = _extract_actions(raw)
+    tags = _extract_tags(raw)
+
+    warnings: List[str] = []
+    if deadline is None:
+        warnings.append("未识别到明确的截止时间，建议手动补充")
+    elif deadline.confidence < 0.75:
+        warnings.append("截止时间置信度偏低，请对照原文核对")
+    if not materials:
+        warnings.append("未识别到材料清单")
+    if not location:
+        warnings.append("未识别到提交地点")
+
+    # 质量自评：用于运行日志里的 quality 指标
+    quality = 0.0
+    quality += 0.5 if deadline else 0.0
+    quality += 0.25 if materials else 0.0
+    quality += 0.15 if location else 0.0
+    quality += 0.10 if actions else 0.0
+
+    return {
+        "ok": True,
+        "title": title,
+        "deadline": deadline.to_dict() if deadline else None,
+        "deadline_human": timeparse.humanize(deadline.dt, now) if deadline else "",
+        "urgency": timeparse.urgency(deadline.dt, now) if deadline else "none",
+        "materials": materials,
+        "location": location or "",
+        "contacts": contacts,
+        "actions": actions,
+        "tags": tags,
+        "warnings": warnings,
+        "quality": round(quality, 2),
+        "evidence": {
+            "deadline": _deadline_evidence(raw, deadline),
+            "materials": material_evidence,
+        },
+        "candidates": timeparse.find_all_times(raw, now=now),
+        "stats": {"chars": len(raw), "sentences": len(split_sentences(raw))},
+    }
+
+
+def _deadline_evidence(text: str, deadline) -> str:
+    """找出包含截止原文的那一句，便于界面并排核对。"""
+    if deadline is None:
+        return ""
+    for sentence in split_sentences(text):
+        if deadline.raw and deadline.raw[:6] in sentence:
+            return sentence[:90]
+    return deadline.raw
diff -ruN iterations/v5_线上部署适配/src/core/store.py iterations/v6_多用户改造/src/core/store.py
--- iterations/v5_线上部署适配/src/core/store.py	1970-01-01 08:00:00.000000000 +0800
+++ iterations/v6_多用户改造/src/core/store.py	2026-11-17 14:10:51.249672700 +0800
@@ -0,0 +1,306 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""数据存储层（SQLite）。
+
+为什么从 JSON 换成 SQLite
+------------------------
+v0.5 之前待办和反馈都是 JSON/JSONL 文件，单用户够用。但加上登录之后变成多用户：
+待办要按人隔离、管理员要跨用户统计、还要存会话。文件方案要么每次全量读写，
+要么自己写锁，很容易出现"两个人同时保存，一个人的记录被覆盖"。
+
+SQLite 是 Python 标准库自带的，仍然是零第三方依赖，但给了事务和并发控制。
+
+表
+--
+users      账号（学号唯一，密码只存 PBKDF2 哈希 + 盐）
+sessions   登录会话（token 主键，带过期时间）
+tasks      待办（归属 user_id，素材存 JSON 字符串）
+feedback   使用反馈（归属 user_id）
+"""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+import threading
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Optional
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS users (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    student_id    TEXT NOT NULL UNIQUE,
+    password_hash TEXT NOT NULL,
+    salt          TEXT NOT NULL,
+    role          TEXT NOT NULL DEFAULT 'student',
+    created_at    TEXT NOT NULL,
+    last_login    TEXT
+);
+
+CREATE TABLE IF NOT EXISTS sessions (
+    token      TEXT PRIMARY KEY,
+    user_id    INTEGER NOT NULL,
+    created_at TEXT NOT NULL,
+    expires_at TEXT NOT NULL,
+    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+);
+
+CREATE TABLE IF NOT EXISTS tasks (
+    id           TEXT PRIMARY KEY,
+    user_id      INTEGER NOT NULL,
+    title        TEXT NOT NULL,
+    deadline     TEXT,
+    deadline_conf REAL DEFAULT 0,
+    urgency      TEXT,
+    location     TEXT,
+    materials    TEXT,
+    tags         TEXT,
+    done         INTEGER NOT NULL DEFAULT 0,
+    created_at   TEXT,
+    done_at      TEXT,
+    note_file    TEXT,
+    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+);
+
+CREATE TABLE IF NOT EXISTS feedback (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    user_id    INTEGER NOT NULL,
+    role       TEXT,
+    score      INTEGER DEFAULT 0,
+    useful     TEXT,
+    comment    TEXT,
+    would_use  INTEGER DEFAULT 0,
+    created_at TEXT,
+    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
+);
+
+CREATE INDEX IF NOT EXISTS idx_tasks_user ON tasks(user_id);
+CREATE INDEX IF NOT EXISTS idx_feedback_user ON feedback(user_id);
+CREATE INDEX IF NOT EXISTS idx_sessions_token ON sessions(token);
+"""
+
+
+class Store:
+    """SQLite 的薄封装。每次操作开一个短连接，避免跨线程共享连接对象。"""
+
+    def __init__(self, db_path: Path) -> None:
+        self.db_path = Path(db_path)
+        self.db_path.parent.mkdir(parents=True, exist_ok=True)
+        self._lock = threading.Lock()
+        with self._conn() as conn:
+            conn.executescript(_SCHEMA)
+
+    @contextmanager
+    def _conn(self):
+        conn = sqlite3.connect(str(self.db_path), timeout=10)
+        conn.row_factory = sqlite3.Row
+        conn.execute("PRAGMA foreign_keys = ON")
+        try:
+            yield conn
+            conn.commit()
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    # ------------------------------------------------------------------ 用户
+    def create_user(self, student_id: str, password_hash: str, salt: str,
+                    role: str, created_at: str) -> int:
+        with self._lock, self._conn() as conn:
+            cur = conn.execute(
+                "INSERT INTO users (student_id, password_hash, salt, role, created_at)"
+                " VALUES (?, ?, ?, ?, ?)",
+                (student_id, password_hash, salt, role, created_at),
+            )
+            return int(cur.lastrowid or 0)
+
+    def get_user_by_student_id(self, student_id: str) -> Optional[Dict[str, Any]]:
+        with self._conn() as conn:
+            row = conn.execute(
+                "SELECT * FROM users WHERE student_id = ?", (student_id,)
+            ).fetchone()
+        return dict(row) if row else None
+
+    def get_user_by_id(self, user_id: int) -> Optional[Dict[str, Any]]:
+        with self._conn() as conn:
+            row = conn.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
+        return dict(row) if row else None
+
+    def touch_login(self, user_id: int, when: str) -> None:
+        with self._lock, self._conn() as conn:
+            conn.execute("UPDATE users SET last_login = ? WHERE id = ?", (when, user_id))
+
+    def list_users(self) -> List[Dict[str, Any]]:
+        with self._conn() as conn:
+            rows = conn.execute(
+                "SELECT u.id, u.student_id, u.role, u.created_at, u.last_login,"
+                "  (SELECT COUNT(*) FROM tasks t WHERE t.user_id = u.id) AS task_count,"
+                "  (SELECT COUNT(*) FROM tasks t WHERE t.user_id = u.id AND t.done = 0) AS open_count,"
+                "  (SELECT COUNT(*) FROM feedback f WHERE f.user_id = u.id) AS feedback_count"
+                " FROM users u ORDER BY u.created_at DESC"
+            ).fetchall()
+        return [dict(r) for r in rows]
+
+    # ------------------------------------------------------------------ 会话
+    def create_session(self, token: str, user_id: int, created_at: str, expires_at: str) -> None:
+        with self._lock, self._conn() as conn:
+            conn.execute(
+                "INSERT INTO sessions (token, user_id, created_at, expires_at) VALUES (?, ?, ?, ?)",
+                (token, user_id, created_at, expires_at),
+            )
+
+    def get_session_user(self, token: str, now: str) -> Optional[Dict[str, Any]]:
+        """token 有效则返回所属用户，过期或不存在返回 None。"""
+        with self._conn() as conn:
+            row = conn.execute(
+                "SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id"
+                " WHERE s.token = ? AND s.expires_at > ?",
+                (token, now),
+            ).fetchone()
+        return dict(row) if row else None
+
+    def delete_session(self, token: str) -> None:
+        with self._lock, self._conn() as conn:
+            conn.execute("DELETE FROM sessions WHERE token = ?", (token,))
+
+    def purge_expired_sessions(self, now: str) -> None:
+        with self._lock, self._conn() as conn:
+            conn.execute("DELETE FROM sessions WHERE expires_at <= ?", (now,))
+
+    # ------------------------------------------------------------------ 待办
+    def add_task(self, task: Dict[str, Any]) -> None:
+        with self._lock, self._conn() as conn:
+            conn.execute(
+                "INSERT INTO tasks (id, user_id, title, deadline, deadline_conf, urgency,"
+                " location, materials, tags, done, created_at, note_file)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    task["id"], task["user_id"], task["title"], task.get("deadline", ""),
+                    task.get("deadline_conf", 0), task.get("urgency", ""),
+                    task.get("location", ""),
+                    json.dumps(task.get("materials", []), ensure_ascii=False),
+                    json.dumps(task.get("tags", []), ensure_ascii=False),
+                    0, task.get("created_at", ""), task.get("note_file", ""),
+                ),
+            )
+
+    @staticmethod
+    def _row_to_task(row: sqlite3.Row) -> Dict[str, Any]:
+        item = dict(row)
+        item["materials"] = json.loads(item.get("materials") or "[]")
+        item["tags"] = json.loads(item.get("tags") or "[]")
+        item["done"] = bool(item.get("done"))
+        return item
+
+    def list_tasks(self, user_id: Optional[int] = None) -> List[Dict[str, Any]]:
+        with self._conn() as conn:
+            if user_id is None:
+                rows = conn.execute("SELECT * FROM tasks ORDER BY created_at DESC").fetchall()
+            else:
+                rows = conn.execute(
+                    "SELECT * FROM tasks WHERE user_id = ? ORDER BY created_at DESC", (user_id,)
+                ).fetchall()
+        return [self._row_to_task(r) for r in rows]
+
+    def task_exists(self, task_id: str) -> bool:
+        with self._conn() as conn:
+            return conn.execute("SELECT 1 FROM tasks WHERE id = ?", (task_id,)).fetchone() is not None
+
+    def set_task_done(self, task_id: str, user_id: int, done: bool, when: str) -> bool:
+        """只允许操作自己的待办，返回是否命中。"""
+        with self._lock, self._conn() as conn:
+            cur = conn.execute(
+                "UPDATE tasks SET done = ?, done_at = ? WHERE id = ? AND user_id = ?",
+                (1 if done else 0, when, task_id, user_id),
+            )
+            return cur.rowcount > 0
+
+    def delete_task(self, task_id: str, user_id: int) -> bool:
+        with self._lock, self._conn() as conn:
+            cur = conn.execute(
+                "DELETE FROM tasks WHERE id = ? AND user_id = ?", (task_id, user_id)
+            )
+            return cur.rowcount > 0
+
+    def count_open_tasks(self, user_id: Optional[int] = None) -> int:
+        with self._conn() as conn:
+            if user_id is None:
+                row = conn.execute("SELECT COUNT(*) AS c FROM tasks WHERE done = 0").fetchone()
+            else:
+                row = conn.execute(
+                    "SELECT COUNT(*) AS c FROM tasks WHERE done = 0 AND user_id = ?", (user_id,)
+                ).fetchone()
+        return int(row["c"]) if row else 0
+
+    # ------------------------------------------------------------------ 反馈
+    def add_feedback(self, item: Dict[str, Any]) -> int:
+        with self._lock, self._conn() as conn:
+            cur = conn.execute(
+                "INSERT INTO feedback (user_id, role, score, useful, comment, would_use, created_at)"
+                " VALUES (?, ?, ?, ?, ?, ?, ?)",
+                (
+                    item["user_id"], item.get("role", ""), item.get("score", 0),
+                    json.dumps(item.get("useful", []), ensure_ascii=False),
+                    item.get("comment", ""), 1 if item.get("would_use") else 0,
+                    item.get("created_at", ""),
+                ),
+            )
+            return int(cur.lastrowid or 0)
+
+    def list_feedback(self, user_id: Optional[int] = None) -> List[Dict[str, Any]]:
+        with self._conn() as conn:
+            if user_id is None:
+                rows = conn.execute(
+                    "SELECT f.*, u.student_id FROM feedback f JOIN users u ON u.id = f.user_id"
+                    " ORDER BY f.created_at DESC"
+                ).fetchall()
+            else:
+                rows = conn.execute(
+                    "SELECT f.*, u.student_id FROM feedback f JOIN users u ON u.id = f.user_id"
+                    " WHERE f.user_id = ? ORDER BY f.created_at DESC", (user_id,)
+                ).fetchall()
+        out = []
+        for row in rows:
+            item = dict(row)
+            item["useful"] = json.loads(item.get("useful") or "[]")
+            item["would_use"] = bool(item.get("would_use"))
+            out.append(item)
+        return out
+
+    def count_feedback(self) -> int:
+        with self._conn() as conn:
+            row = conn.execute("SELECT COUNT(*) AS c FROM feedback").fetchone()
+        return int(row["c"]) if row else 0
+
