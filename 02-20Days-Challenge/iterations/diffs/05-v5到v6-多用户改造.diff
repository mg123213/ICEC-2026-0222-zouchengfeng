+  border-radius: 8px;
+  background: var(--blue);
+  color: #fff;
+  display: grid; place-items: center;
+  font-size: 15px; font-weight: 600;
+}
+
+.auth-sub {
+  font-size: 12.5px;
+  color: var(--ink-3);
+  margin: 6px 0 22px;
+}
+
+.auth-tabs {
+  display: flex;
+  gap: 6px;
+  background: #f2f4f8;
+  border-radius: 8px;
+  padding: 3px;
+  margin-bottom: 4px;
+}
+
+.auth-tabs button {
+  flex: 1;
+  appearance: none;
+  border: 0;
+  background: transparent;
+  border-radius: 6px;
+  padding: 7px 0;
+  font: inherit;
+  font-size: 13px;
+  color: var(--ink-2);
+  cursor: pointer;
+}
+
+.auth-tabs button.active {
+  background: #fff;
+  color: var(--blue);
+  font-weight: 500;
+  box-shadow: var(--shadow);
+}
+
+.auth-msg {
+  margin-top: 12px;
+  font-size: 12.5px;
+  min-height: 18px;
+  color: var(--red);
+}
+.auth-msg.ok { color: var(--green); }
+
+.auth-foot {
+  margin-top: 18px;
+  padding-top: 14px;
+  border-top: 1px solid var(--line);
+  font-size: 12px;
+  color: var(--ink-3);
+  line-height: 1.7;
+}
+
+/* ================= 顶栏 ================= */
+.topbar {
+  background: var(--card);
+  border-bottom: 1px solid var(--line);
+}
+
+.topbar-inner {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 12px 20px;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.brand { display: flex; align-items: center; gap: 9px; }
+
+.logo {
+  width: 30px; height: 30px;
+  border-radius: 7px;
+  background: var(--blue);
+  color: #fff;
+  display: grid; place-items: center;
+  font-size: 14px; font-weight: 600;
+}
+
+.brand-text h1 { font-size: 15px; }
+.brand-text p { margin: 1px 0 0; font-size: 11.5px; color: var(--ink-3); }
+
+.topbar-right {
+  margin-left: auto;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.user-chip {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 12.5px;
+  color: var(--ink-2);
+  background: #f5f7fa;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 4px 12px 4px 6px;
+}
+
+.user-avatar {
+  width: 22px; height: 22px;
+  border-radius: 50%;
+  background: var(--blue-soft);
+  color: var(--blue);
+  display: grid; place-items: center;
+  font-size: 11px; font-weight: 600;
+}
+
+.role-tag {
+  font-size: 10.5px;
+  padding: 1px 7px;
+  border-radius: 999px;
+  background: var(--blue-soft);
+  color: var(--blue);
+  border: 1px solid var(--blue-line);
+}
+
+/* ================= 标签页 ================= */
+.tabs {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 0 20px;
+  display: flex;
+  gap: 2px;
+  border-bottom: 1px solid var(--line);
+}
+
+.tab {
+  appearance: none;
+  border: 0;
+  background: transparent;
+  padding: 11px 14px;
+  font: inherit;
+  font-size: 13.5px;
+  color: var(--ink-2);
+  cursor: pointer;
+  border-bottom: 2px solid transparent;
+  margin-bottom: -1px;
+}
+
+.tab:hover { color: var(--ink); }
+.tab.active { color: var(--blue); border-bottom-color: var(--blue); font-weight: 500; }
+
+.badge {
+  display: inline-block;
+  min-width: 17px;
+  padding: 0 5px;
+  border-radius: 9px;
+  background: var(--blue-soft);
+  color: var(--blue);
+  font-size: 11px;
+  line-height: 17px;
+  text-align: center;
+}
+
+/* ================= 主体 ================= */
+main { max-width: 1120px; margin: 0 auto; padding: 20px; }
+
+.panel { display: none; }
+.panel.active { display: block; }
+
+.split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
+.split.tight { gap: 14px; }
+
+@media (max-width: 900px) {
+  .split { grid-template-columns: 1fr; }
+  .topbar-inner { flex-wrap: wrap; }
+}
+
+.privacy { margin: 8px 0 0; font-size: 11.5px; color: var(--ink-3); }
+
+.empty {
+  min-height: 300px;
+  display: grid;
+  place-content: center;
+  text-align: center;
+  gap: 4px;
+  color: var(--ink-3);
+}
+.empty p { margin: 0; font-size: 13.5px; color: var(--ink-2); }
+.empty span { font-size: 12px; }
+
+/* 解析结果 */
+.res-title { font-size: 15.5px; line-height: 1.5; margin-bottom: 12px; font-weight: 500; }
+
+.deadline-box {
+  border-radius: 8px;
+  padding: 12px 14px;
+  background: var(--green-soft);
+  border: 1px solid #d5ecdf;
+  margin-bottom: 14px;
+}
+.deadline-box.soon { background: var(--amber-soft); border-color: #f3e2c7; }
+.deadline-box.today, .deadline-box.overdue { background: var(--red-soft); border-color: #f3d3d3; }
+.deadline-box.none { background: #f7f8fa; border-color: var(--line); }
+
+.deadline-main { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
+.deadline-date { font-size: 19px; font-weight: 600; font-variant-numeric: tabular-nums; }
+.deadline-left { font-size: 12.5px; font-weight: 500; }
+.deadline-raw { font-size: 11.5px; color: var(--ink-3); margin-top: 3px; }
+
+.chip-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
+
+.tag {
+  font-size: 11px;
+  padding: 1px 8px;
+  border-radius: 999px;
+  background: var(--blue-soft);
+  color: var(--blue);
+}
+
+.kv { display: grid; grid-template-columns: 72px 1fr; gap: 7px 10px; font-size: 13px; }
+.kv dt { color: var(--ink-3); }
+.kv dd { margin: 0; }
+
+.mat-list { margin: 0; padding-left: 17px; }
+.mat-list li { margin: 2px 0; font-size: 13px; }
+.mat-qty { color: var(--blue); font-weight: 500; }
+
+.warn-box {
+  margin-top: 12px;
+  padding: 9px 11px;
+  border-left: 3px solid #e0a94a;
+  background: #fffaf0;
+  border-radius: 0 6px 6px 0;
+  font-size: 12.5px;
+  color: #7a5b1a;
+}
+.warn-box ul { margin: 0; padding-left: 15px; }
+
+details.evidence { margin-top: 12px; font-size: 12.5px; }
+details.evidence summary { cursor: pointer; color: var(--blue); }
+details.evidence pre {
+  white-space: pre-wrap;
+  background: #f7f8fa;
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 9px;
+  font-size: 11.5px;
+  color: var(--ink-2);
+  margin: 7px 0 0;
+}
+
+.result-actions { display: flex; gap: 8px; margin-top: 16px; }
+
+/* 待办 */
+.task-list { display: grid; gap: 9px; }
+
+.task {
+  display: flex;
+  gap: 12px;
+  align-items: flex-start;
+  padding: 12px 14px;
+  border: 1px solid var(--line);
+  border-left: 3px solid var(--line);
+  border-radius: 8px;
+  background: #fff;
+}
+.task:hover { background: #fbfcfe; }
+.task.urgent { border-left-color: var(--red); }
+.task.soon { border-left-color: var(--amber); }
+.task.normal { border-left-color: var(--green); }
+.task.done { opacity: .55; }
+.task.done .task-title { text-decoration: line-through; }
+
+.task-body { flex: 1; min-width: 0; }
+.task-title { font-size: 13.5px; font-weight: 500; margin-bottom: 2px; }
+.task-meta { font-size: 12px; color: var(--ink-3); display: flex; gap: 10px; flex-wrap: wrap; }
+.task-meta .due { color: var(--ink-2); font-variant-numeric: tabular-nums; }
+
+.task-actions { display: flex; gap: 5px; }
+
+.icon-btn {
+  appearance: none;
+  border: 1px solid var(--line);
+  background: #fff;
+  border-radius: 7px;
+  width: 28px; height: 28px;
+  cursor: pointer;
+  color: var(--ink-3);
+  font-size: 13px;
+  line-height: 1;
+}
+.icon-btn:hover { color: var(--blue); border-color: var(--blue-line); }
+
+/* 器材 */
+.mini-stats { display: flex; gap: 9px; flex-wrap: wrap; margin-bottom: 14px; }
+.mini-stat {
+  background: #f8f9fb;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 7px 13px;
+  text-align: center;
+  min-width: 88px;
+}
+.mini-stat b { display: block; font-size: 17px; font-variant-numeric: tabular-nums; font-weight: 600; }
+.mini-stat span { font-size: 11px; color: var(--ink-3); }
+.mini-stat.alert b { color: var(--red); }
+.mini-stat.warn b { color: var(--amber); }
+
+.table-wrap { overflow-x: auto; }
+
+table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
+th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--line); white-space: nowrap; }
+th { color: var(--ink-3); font-weight: 500; font-size: 11.5px; background: #fafbfc; }
+td.num { font-variant-numeric: tabular-nums; }
+
+.pill { font-size: 11px; padding: 1px 8px; border-radius: 999px; }
+.pill.overdue { background: var(--red-soft); color: var(--red); }
+.pill.partial { background: var(--amber-soft); color: var(--amber); }
+.pill.open { background: #eef1f6; color: var(--ink-2); }
+.pill.ok { background: var(--green-soft); color: var(--green); }
+
+.reminder-box { margin-top: 16px; border-top: 1px solid var(--line); padding-top: 14px; }
+.reminder-box pre {
+  white-space: pre-wrap;
+  background: #f8f9fb;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 11px;
+  font-size: 12.5px;
+  color: var(--ink-2);
+  margin: 8px 0;
+  font-family: inherit;
+}
+
+.anomaly {
+  margin-top: 9px;
+  padding: 9px 11px;
+  border-radius: 6px;
+  background: var(--red-soft);
+  color: #9c2b2b;
+  font-size: 12.5px;
+}
+
+/* 反馈 */
+.stars { display: flex; align-items: center; gap: 3px; }
+.stars button {
+  appearance: none;
+  border: 0;
+  background: none;
+  font-size: 22px;
+  line-height: 1;
+  color: #d5dae3;
+  cursor: pointer;
+  padding: 0 1px;
+}
+.stars button.on { color: #e6a52a; }
+#fb-score-label { font-size: 12.5px; color: var(--ink-3); margin-left: 7px; }
+
+.chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 4px; }
+.chip { position: relative; cursor: pointer; }
+.chip input { position: absolute; opacity: 0; pointer-events: none; }
+.chip span {
+  display: inline-block;
+  padding: 5px 12px;
+  border: 1px solid var(--line-2);
+  border-radius: 999px;
+  font-size: 12.5px;
+  color: var(--ink-2);
+  background: #fff;
+}
+.chip input:checked + span {
+  background: var(--blue-soft);
+  border-color: var(--blue-line);
+  color: var(--blue);
+}
+
+.checkline { display: flex; align-items: center; gap: 7px; margin-top: 14px; font-size: 13px; }
+
+.feedback-echo {
+  white-space: pre-wrap;
+  word-break: break-all;
+  background: #f8f9fb;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 9px 11px;
+  font-size: 11px;
+  line-height: 1.55;
+  color: var(--ink-2);
+  margin: 8px 0;
+  font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
+}
+
+/* ================= 管理后台 ================= */
+.admin-head {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 22px 20px 4px;
+}
+
+.admin-head h1 { font-size: 19px; }
+.admin-head p { margin: 4px 0 0; font-size: 12.5px; color: var(--ink-3); }
+
+.stat-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 10px;
+  margin-bottom: 16px;
+}
+
+@media (max-width: 720px) {
+  .stat-grid { grid-template-columns: repeat(2, 1fr); }
+}
+
+.stat-card {
+  background: #fff;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 13px 15px;
+}
+
+.stat-card b {
+  display: block;
+  font-size: 22px;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  line-height: 1.3;
+}
+
+.stat-card span { font-size: 11.5px; color: var(--ink-3); }
+.stat-card.accent b { color: var(--blue); }
+.stat-card.warn b { color: var(--amber); }
+
+.admin-tabs {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 0 20px;
+  display: flex;
+  gap: 2px;
+  border-bottom: 1px solid var(--line);
+}
+
+.admin-body { max-width: 1120px; margin: 0 auto; padding: 18px 20px 40px; }
+
+.admin-panel { display: none; }
+.admin-panel.active { display: block; }
+
+.empty-row { padding: 28px; text-align: center; color: var(--ink-3); font-size: 13px; }
+
+.bar-row {
+  display: grid;
+  grid-template-columns: 88px 1fr 44px;
+  gap: 10px;
+  align-items: center;
+  font-size: 12.5px;
+  margin-bottom: 7px;
+}
+
+.bar-track { height: 8px; background: #eceff4; border-radius: 4px; overflow: hidden; }
+.bar-fill {
+  display: block;
+  height: 100%;
+  min-width: 3px;
+  background: #2f6fed;
+  border-radius: 4px;
+}
+.bar-num { text-align: right; color: var(--ink-3); font-variant-numeric: tabular-nums; }
+
+/* ================= 页脚 ================= */
+footer {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 0 20px 26px;
+  display: flex;
+  justify-content: space-between;
+  font-size: 11.5px;
+  color: var(--ink-3);
+  flex-wrap: wrap;
+  gap: 8px;
+}
